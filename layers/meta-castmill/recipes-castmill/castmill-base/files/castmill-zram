#!/bin/sh
# Compressed swap in RAM (spec 05: no swap on flash).
set -eu
case "${1:-start}" in
start)
    modprobe zram num_devices=1 2>/dev/null || true
    [ -e /sys/block/zram0 ] || { echo "zram not available"; exit 0; }
    mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    size=$((mem_kb / 2))K
    for alg in zstd lz4 lzo-rle lzo; do
        echo "$alg" > /sys/block/zram0/comp_algorithm 2>/dev/null && break
    done
    echo "$size" > /sys/block/zram0/disksize
    mkswap -L zram0 /dev/zram0 >/dev/null
    swapon -p 100 /dev/zram0
    ;;
stop)
    swapoff /dev/zram0 2>/dev/null || true
    echo 1 > /sys/block/zram0/reset 2>/dev/null || true
    ;;
esac
