# Castmill OS disk layout for Raspberry Pi 5 / CM5. Same partitions as the
# UEFI layout (spec 02) so /data, provisioning and factory reset work the same.
# TODO (Phase 0): A/B boot (tryboot vs U-Boot, spec 03). Until then the
# device always boots rootfs_a and RAUC is not installed.

bootloader --ptable gpt

part /boot --source bootimg_partition --fstype=vfat --label boot --part-name boot --uuid ${CASTMILL_UUID_BOOT} --active --align 4096 --fixed-size 256M --no-fstab-update

part --source rootfs --fstype=ext4 --label rootfs --part-name rootfs_a --uuid ${CASTMILL_UUID_ROOTFS_A} --align 4096 --fixed-size ${CASTMILL_SLOT_SIZE} --no-fstab-update

part --fstype=ext4 --label rootfs --part-name rootfs_b --uuid ${CASTMILL_UUID_ROOTFS_B} --align 4096 --fixed-size ${CASTMILL_SLOT_SIZE} --no-fstab-update

part --fstype=ext4 --label data --part-name data --uuid ${CASTMILL_UUID_DATA} --align 4096 --size 512M --no-fstab-update
